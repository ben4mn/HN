{
  "id": "hn-reader",
  "name": "HN — Hacker News reader",
  "short_name": "HN",
  "description": "A fast, readable Hacker News client with a built-in article reader and threaded comments.",
  "start_url": "./#/top",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#131110",
  "theme_color": "#131110",
  "lang": "en",
  "categories": ["news", "social"],
  "icons": [
    { "src": "static/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "static/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "static/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "static/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Top stories", "url": "./#/top", "icons": [{ "src": "static/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "New stories", "url": "./#/new", "icons": [{ "src": "static/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Ask HN", "url": "./#/ask", "icons": [{ "src": "static/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Saved", "url": "./#/saved", "icons": [{ "src": "static/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
